# ─────────────────────────────────────────────
# Billing Platform Backend V3 — Docker Environment
# Copia este archivo a .env y ajusta los valores
# ─────────────────────────────────────────────

APP_NAME=BillingPlatform
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api-montex-staging.artra.cloud
APP_KEY=

# PostgreSQL (master_v3 — única BD necesaria para V3)
MASTER_V3_DB_HOST=db_v3
MASTER_V3_DB_PORT=5432
MASTER_V3_DB_DATABASE=master_v3
MASTER_V3_DB_USERNAME=billing_user
MASTER_V3_DB_PASSWORD=secret

# Conexión por defecto (V3 usa master_v3)
DB_CONNECTION=master_v3
DB_HOST=db_v3
DB_PORT=5432
DB_DATABASE=master_v3
DB_USERNAME=billing_user
DB_PASSWORD=secret

# Cache/Queue/Session — V3 no necesita tablas en enterprises
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie

# Redis (para auth challenges)
REDIS_CLIENT=predis
REDIS_HOST=challenge-redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=0

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error

# SRI — modo mock (sin llamadas reales al SRI)
SRI_PROVIDER_RUC=1752331700001
SRI_MOCK=true
SRI_MODE=celcer
SRI_ENVIRONMENT=staging
SRI_INVOICE_XSD=/var/www/html/resources/sri/xsd/factura_V2.1.0.xsd

# OpenBao (modo dev, sin TLS)
OPENBAO_ADDR=http://openbao:8200
OPENBAO_CREDENTIALS_DIRECTORY=/run/secrets/openbao/keys

# CORS
CORS_ALLOWED_ORIGINS=*
CORS_SUPPORTS_CREDENTIALS=true
